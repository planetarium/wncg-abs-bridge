# WalletConnect Cloud project id — required by RainbowKit for WalletConnect-based wallets.
# Get one free at https://cloud.reown.com (formerly WalletConnect Cloud).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: point at testnet (Abstract Sepolia <-> Ethereum Sepolia) instead of mainnet.
# Set to "testnet" to use the testnet pair. Anything else (or empty) = mainnet.
NEXT_PUBLIC_BRIDGE_NETWORK=mainnet
