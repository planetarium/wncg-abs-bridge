# WalletConnect / Reown Cloud project id (from cloud.reown.com).
# Injected wallets (MetaMask, Rabby) work without it; WalletConnect/mobile QR needs it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional custom RPCs. When set, each is tried FIRST in the fallback list (e.g. a paid
# Alchemy/Infura endpoint). Leave blank to use the bundled public-RPC fallback set.
NEXT_PUBLIC_L1_RPC_URL=
NEXT_PUBLIC_L2_RPC_URL=
